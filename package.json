{
  "name": "rcyc-auth0-acul",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "build:rendering": "npm run build && node scripts/generate-rendering-config.mjs",
    "dev": "vite --host 0.0.0.0 --port 55444",
    "dev:login": "auth0 acul dev --tenant dev-t63fs8uohee0yl4k.us.auth0.com --port 55444 --screens login",
    "dev:connected": "auth0 acul dev --connected --tenant dev-t63fs8uohee0yl4k.us.auth0.com --port 55444 --screens login",
    "preview": "vite preview --host 0.0.0.0",
    "validate": "node scripts/validate-acul.mjs"
  },
  "dependencies": {
    "@auth0/auth0-acul-react": "1.7.0",
    "react": "19.1.2",
    "react-dom": "19.1.2"
  },
  "devDependencies": {
    "@auth0/ul-context-inspector": "1.1.3",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "7.1.12"
  }
}
